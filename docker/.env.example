# Docker settings. Copy to docker/.env (git-ignored) and fill in NEW random values:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the passwords or secret from the Windows .env.

# PostgreSQL superuser inside the db container (schema migrations, restores, operator tools).
PG_OWNER_USER=rag_owner
PG_OWNER_PASSWORD=

# The API's least-privilege role; set on every start by the migrate service. 16+ characters.
APP_DB_PASSWORD=

# Signs login tokens. 43+ random characters.
JWT_SECRET_KEY=

# Answer model. Ollama runs on the host (it keeps the GPU); containers reach it here.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b-it-q4_K_M
OLLAMA_URL=http://host.docker.internal:11434
# Only for LLM_PROVIDER=gemini (free tier).
GEMINI_API_KEY=

# The site is published on this host port, on 127.0.0.1 only: http://localhost:8180
WEB_PORT=8180
