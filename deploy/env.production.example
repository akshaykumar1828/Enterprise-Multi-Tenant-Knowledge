# Production .env template. Create the real .env on the server with FRESH
# values; never copy the development .env. Keep it readable only by the
# account that runs the API.

APP_ENV=production

# API database identity: the least-privilege role. Written by
#   python -m src.rag.db_roles create-app-role --role rag_app
APP_DB_USER=rag_app
APP_DB_PASSWORD=

# Where PostgreSQL is (local only). The owner role (PGUSER/PGPASSWORD) is needed
# only by operator commands (migrations, ingestion, user management); prefer to
# set it in that shell session instead of storing it here.
PGHOST=localhost
PGPORT=5432
PGDATABASE=enterprise_rag
# PGUSER=
# PGPASSWORD=

# A NEW random secret. Production startup rejects values shorter than 43 characters,
# with little variety, or containing placeholder words. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

GEMINI_API_KEY=

UPLOAD_DIR=
UPLOAD_MAX_BYTES=10485760

# Models are already cached locally; do not contact the Hugging Face Hub at startup.
HF_HUB_OFFLINE=1

# --- Limits (the values shown are the production defaults; omit a line to keep it) ---
# Self-service sign-up: closed by default in production. Create users with
#   python -m src.rag.users create --tenant <slug> --email <email>
REGISTRATION_MODE=closed
# Rate limits ("<count>/<second|minute|hour|day>" or "off"). On by default in production.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_LOGIN=5/minute        # per client IP + email
RATE_LIMIT_REGISTER=3/hour       # per client IP
RATE_LIMIT_QUERIES=30/minute     # per tenant, every question
RATE_LIMIT_ANSWERS=20/day        # per tenant, questions answered by Gemini
RATE_LIMIT_UPLOADS=20/hour       # per tenant
# Per-tenant limits on uploaded documents (folder-ingested documents do not count). 0 = unlimited.
TENANT_MAX_DOCUMENTS=500
TENANT_MAX_UPLOAD_BYTES=1073741824

# --- Database connections for the API (defaults shown) ---
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10            # keep conservative; the API runs one worker
DB_POOL_TIMEOUT=5              # seconds to wait for a free connection, then 503 database_busy
DB_CONNECT_TIMEOUT=5           # seconds
DB_STATEMENT_TIMEOUT_MS=15000  # per SQL statement, then 503 database_timeout

# --- Logging (defaults shown for production) ---
LOG_LEVEL=INFO
LOG_FORMAT=json                # one JSON object per line, with request_id
LOG_REQUESTS=true              # method, path, status, duration, client IP; no bodies or tokens
