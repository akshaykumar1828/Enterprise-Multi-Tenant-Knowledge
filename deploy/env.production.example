# Production .env template. The API reads <project root>\.env. Create it on the server
# with FRESH values; never copy the development .env (keep that one as .env.development,
# which is git-ignored). Keep .env readable only by the account that runs the API.
# See deploy\PRODUCTION_RUNBOOK.md, step 4.

APP_ENV=production

# API database identity: the least-privilege role. Leave both lines as they are; this
# command (run as the owner, see the runbook) sets a new random password and writes both
# values into this file without printing them:
#   python -m src.rag.db_roles create-app-role --role rag_app
APP_DB_USER=rag_app
APP_DB_PASSWORD=

# Where PostgreSQL is (local only). The owner role (PGUSER/PGPASSWORD) is needed only by
# operator commands (migrations, ingestion, user management, backups); set it in that
# shell session instead of storing it here.
PGHOST=localhost
PGPORT=5432
PGDATABASE=enterprise_rag
# PGUSER=
# PGPASSWORD=

# A NEW random secret (do not reuse the development one). Production startup rejects
# values shorter than 43 characters, with little variety, or containing placeholder
# words. Generate it into this file without displaying it (see the runbook), or with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Answer model. "ollama" (default): a local model served by Ollama on this machine - free,
# no usage limits, document text never leaves the server. Ollama must be running
# (http://127.0.0.1:11434) and the model pulled:  ollama pull gemma3:4b-it-q4_K_M
# "gemini": Google Gemini free tier (about 20 answers a day); needs GEMINI_API_KEY.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b-it-q4_K_M
# OLLAMA_URL=http://127.0.0.1:11434
# Only for LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Absolute path, writable by the API account, included in backups (deploy\BACKUP.md).
UPLOAD_DIR=C:\rag-data\uploads

# Models are already cached locally; do not contact the Hugging Face Hub at startup.
# (Where the cache is - HF_HOME - is passed by the startup task, not set here: the
# model library reads it before this file is loaded.)
HF_HUB_OFFLINE=1

# --- Limits (the values shown are the production defaults; omit a line to keep it) ---
# Self-service sign-up: closed by default in production. Create users with
#   python -m src.rag.users create --tenant <slug> --email <email>
# and make the first admin with
#   python -m src.rag.users set-role --email <email> --role admin
REGISTRATION_MODE=closed
# Rate limits ("<count>/<second|minute|hour|day>" or "off"). On by default in production.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_LOGIN=5/minute        # per client IP + email
RATE_LIMIT_REGISTER=3/hour       # per client IP
RATE_LIMIT_QUERIES=30/minute     # per tenant, every question
RATE_LIMIT_ANSWERS=off           # per tenant, written answers; "off" for the local model, 20/day for Gemini
RATE_LIMIT_UPLOADS=20/hour       # per tenant
# Per-tenant limits on uploaded documents (folder-ingested documents do not count). 0 = unlimited.
TENANT_MAX_DOCUMENTS=500
TENANT_MAX_UPLOAD_BYTES=1073741824
# Per-upload resource limits (positive integers), checked before anything is embedded.
UPLOAD_MAX_BYTES=10485760        # 10 MiB per file (Caddy allows 11 MB request bodies)
UPLOAD_MAX_PDF_PAGES=300
UPLOAD_MAX_TEXT_CHARS=1000000
UPLOAD_MAX_CHUNKS=2000

# --- Database connections for the API (defaults shown) ---
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10            # keep conservative; the API runs one worker
DB_POOL_TIMEOUT=5              # seconds to wait for a free connection, then 503 database_busy
DB_CONNECT_TIMEOUT=5           # seconds
DB_STATEMENT_TIMEOUT_MS=15000  # per SQL statement, then 503 database_timeout

# --- Logging (defaults shown for production) ---
LOG_LEVEL=INFO
LOG_FORMAT=json                # one JSON object per line, with request_id
LOG_REQUESTS=true              # method, path, status, duration, client IP; no bodies or tokens
