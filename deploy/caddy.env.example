# Caddy settings for the "RAG Caddy" startup task (start_caddy_task.ps1 reads this file
# and starts Caddy with these variables). Copy to deploy\caddy.env (git-ignored) and
# adjust. One KEY=VALUE per line; no quotes needed, even for paths with spaces.
# No secrets belong here.

# The public hostname. DNS must point to this machine and ports 80/443 must reach it;
# Caddy then obtains and renews the Let's Encrypt certificate itself.
SITE_ADDRESS=knowledge.example.com

# Absolute path of the built frontend (npm --prefix frontend run build).
FRONTEND_DIST=C:\path\to\Enterprise Multi-Tenant Knowledge\frontend\dist

# Folder for Caddy's JSON access log (access.log, rotated at 50 MiB, 10 kept).
CADDY_LOG_DIR=C:\rag-logs

# Caddy's local admin API, loopback only. localhost:2019 is Caddy's default; on machines
# where Windows blocks port 2019 use another local port.
CADDY_ADMIN=localhost:2999
