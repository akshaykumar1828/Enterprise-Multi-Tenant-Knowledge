# Copy to .env.local to override. Only VITE_* variables reach the browser,
# so never put secrets here (the Gemini key stays on the backend).

# Base URL of the FastAPI server as seen by the browser. Leave empty in
# development: the Vite dev server forwards /api to API_PROXY_TARGET.
VITE_API_BASE_URL=

# Where the dev server forwards /api requests (dev only, not sent to the browser).
API_PROXY_TARGET=http://127.0.0.1:8000
